NODE_ENV=development
PORT=3333

# Postgres do docker-compose.yml da raiz (porta 5433 no host)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=ubs
DB_PASSWORD=ubs
DB_NAME=ubs_digital

# Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-segredo
# Em segundos (604800 = 7 dias)
JWT_EXPIRES_IN=604800

# Origens web permitidas, separadas por vírgula (Expo Web usa 8081)
CORS_ORIGINS=http://localhost:8081

# Base dos links de ação enviados nas mensagens (RN-73: domínio reconhecível pelo paciente)
LINK_BASE_URL=http://localhost:3333

# Fuso dos horários "manhã do dia" dos lembretes (RN-10)
TZ=America/Sao_Paulo

# Intervalo do relógio dos jobs em desenvolvimento; 0 desliga (o endpoint /dev dispara à mão)
JOBS_INTERVALO_MS=60000
